{
  "bridge": {
    "auto": true,
    "url": "",
    "token": ""
  },
  "focus_file": "/run/user/1000/macrodeck-focus.json",
  "poll_interval_ms": 250,
  "debounce_ms": 300,
  "client": null,
  "rules": [
    {
      "name": "Blender",
      "match": {
        "app_id": "^blender$",
        "wm_class": "^blender$"
      },
      "folder": "Main / Blender",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "OBS Studio",
      "match": {
        "app_id": "^com\\.obsproject\\.Studio$",
        "wm_class": "^com\\.obsproject\\.Studio$"
      },
      "folder": "Main / OBS Studio",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "Obsidian",
      "match": {
        "app_id": "^obsidian$",
        "wm_class": "^obsidian$"
      },
      "folder": "Main / Obsidian",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "GNOME Terminal",
      "match": {
        "app_id": "^org\\.gnome\\.Terminal$",
        "wm_class": "^org\\.gnome\\.Terminal$"
      },
      "folder": "Main / Scripts",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "OpenCode (terminal)",
      "match": {
        "app_id": "^ai\\.opencode\\.desktop$",
        "wm_class": "^ai\\.opencode\\.desktop$"
      },
      "folder": "Main / Scripts",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "Zen Browser",
      "match": {
        "app_id": "^app\\.zen_browser\\.zen$",
        "wm_class": "^app\\.zen_browser\\.zen$"
      },
      "folder": "Main / Apps",
      "profile": null,
      "return_on_focus_loss": false
    },
    {
      "name": "VSCodium",
      "match": {
        "app_id": "^codium$",
        "wm_class": "^codium$"
      },
      "folder": "Main / Apps",
      "profile": null,
      "return_on_focus_loss": false
    }
  ]
}